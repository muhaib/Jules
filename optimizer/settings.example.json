{
  "env": {
    "OPTIMIZER_MODE": "balanced"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "bash optimizer/hooks/session-start.sh" }] }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash optimizer/hooks/compress-bash.sh" }]
      },
      {
        "matcher": "Read",
        "hooks": [{ "type": "command", "command": "bash optimizer/hooks/compress-read.sh" }]
      }
    ]
  }
}
