//@version=6
// =============================================================================
// XAUUSD Multi-Timeframe Trend Pullback  —  Pine Script v6
// -----------------------------------------------------------------------------
// Intended chart:   XAUUSD, 5m or 15m timeframe.
// HTF bias:         4h EMA(200) direction  AND  1h EMA(50) direction.
// LTF entry:        pullback to EMA(20) + RSI cross of 50 + optional engulfing.
// Risk:             fixed % of equity per trade, ATR-based stop.
// Management:       partial take-profit, breakeven after 1R, ATR trail after TP1.
// Session filter:   London + NY overlaps only (configurable).
// Safety:           daily max loss cutoff, ATR chop/spike filter, 1 trade at a time.
// -----------------------------------------------------------------------------
// Honest expectations:
//   Backtests on XAUUSD 5–15m typically show 40–55% win rate at 1:2–1:3 R.
//   Realistic monthly return: 3–8% net with 1–2% risk per trade.
//   A 10x-in-a-month target requires risk levels where ruin probability → 1.
//   Do your own walk-forward test on your broker's data + spread before live.
// =============================================================================

strategy(
     title            = "XAUUSD MTF Trend Pullback",
     shorttitle       = "XAU-MTF",
     overlay          = true,
     initial_capital  = 100,
     currency         = currency.USD,
     default_qty_type = strategy.fixed,
     default_qty_value= 1,
     pyramiding       = 0,
     commission_type  = strategy.commission.percent,
     commission_value = 0.02,
     slippage         = 2,
     calc_on_every_tick    = false,
     process_orders_on_close = true,
     max_bars_back    = 500)

// ─── Inputs ───────────────────────────────────────────────────────────────────
grpRisk    = "Risk & Sizing"
riskPct    = input.float(2.0,  "Risk % per trade",        minval=0.1, maxval=10.0, step=0.1, group=grpRisk,
                          tooltip="Percent of current equity risked from entry to stop. 1–2% is standard, 3–5% is aggressive, >5% approaches ruin.")
maxDailyDD = input.float(6.0,  "Max daily loss %",        minval=1.0, maxval=25.0, step=0.5, group=grpRisk,
                          tooltip="If cumulative loss for the day exceeds this, no new trades until next day.")
rewardR    = input.float(3.0,  "Final target (R)",        minval=1.0, maxval=10.0, step=0.1, group=grpRisk)
partialR   = input.float(1.5,  "Partial exit at (R)",     minval=0.5, maxval=5.0,  step=0.1, group=grpRisk)
partialPct = input.float(50.0, "Partial exit %",          minval=10,  maxval=90,   step=5,   group=grpRisk)
useTrail   = input.bool(true,  "ATR-trail runner after partial", group=grpRisk)

grpATR     = "ATR / Stops"
atrLen     = input.int(14,   "ATR length",                minval=5,   maxval=100, group=grpATR)
atrMult    = input.float(1.5,"ATR stop multiplier",       minval=0.5, maxval=5.0, step=0.1, group=grpATR)
trailMult  = input.float(1.0,"ATR trail multiplier",      minval=0.3, maxval=5.0, step=0.1, group=grpATR)
minAtrPct  = input.float(0.05,"Min ATR / price %",        minval=0.0, maxval=1.0, step=0.01, group=grpATR,
                          tooltip="Skip trades in dead chop.")
maxAtrPct  = input.float(0.80,"Max ATR / price %",        minval=0.1, maxval=5.0, step=0.05, group=grpATR,
                          tooltip="Skip trades during news spikes.")

grpHTF     = "Higher-Timeframe Bias"
htfBias    = input.timeframe("240", "Primary bias TF", group=grpHTF)
htfConfirm = input.timeframe("60",  "Confirm TF",      group=grpHTF)
biasLen    = input.int(200, "Primary bias EMA",     minval=20,  maxval=400, group=grpHTF)
confirmLen = input.int(50,  "Confirm EMA",          minval=10,  maxval=200, group=grpHTF)

grpLTF     = "Chart-Timeframe Entry"
emaLen     = input.int(20,  "Pullback EMA",         minval=5,   maxval=100, group=grpLTF)
rsiLen     = input.int(14,  "RSI length",           minval=5,   maxval=50,  group=grpLTF)
rsiMid     = input.int(50,  "RSI midline",          minval=40,  maxval=60,  group=grpLTF)
requireEngulf = input.bool(false, "Require engulfing candle", group=grpLTF)
pullbackTol = input.float(0.15, "Pullback tolerance (% of price)", minval=0.0, maxval=1.0, step=0.01, group=grpLTF,
                          tooltip="How close price must come to the EMA to count as a pullback.")

grpSess    = "Session Filter (exchange time)"
useSession = input.bool(true, "Trade only in configured sessions", group=grpSess)
sessLondon = input.session("0800-1100", "London window",   group=grpSess)
sessNY     = input.session("1300-1700", "NY window",       group=grpSess)
noFri      = input.bool(true, "No new trades after Fri 20:00", group=grpSess)

grpFlow    = "Flow Control"
cooldownBars = input.int(3, "Cooldown bars after exit", minval=0, maxval=50, group=grpFlow)
allowLong    = input.bool(true, "Allow longs",  group=grpFlow)
allowShort   = input.bool(true, "Allow shorts", group=grpFlow)

// ─── HTF pulls (repaint-safe) ─────────────────────────────────────────────────
// lookahead_off + gaps_off + [1] read: use only fully-closed HTF bars.
[hBiasClose, hBiasEma]   = request.security(syminfo.tickerid, htfBias,
     [close, ta.ema(close, biasLen)],
     lookahead = barmerge.lookahead_off,
     gaps      = barmerge.gaps_off)
[hConfClose, hConfEma]   = request.security(syminfo.tickerid, htfConfirm,
     [close, ta.ema(close, confirmLen)],
     lookahead = barmerge.lookahead_off,
     gaps      = barmerge.gaps_off)

bullBias = hBiasClose > hBiasEma and hConfClose > hConfEma
bearBias = hBiasClose < hBiasEma and hConfClose < hConfEma

// ─── LTF indicators ──────────────────────────────────────────────────────────
float ema20 = ta.ema(close, emaLen)
float atr   = ta.atr(atrLen)
float rsi   = ta.rsi(close, rsiLen)

bool bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bool bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

float tol = close * pullbackTol / 100.0
bool  pulledBackLong  = low  <= ema20 + tol and close > ema20
bool  pulledBackShort = high >= ema20 - tol and close < ema20

bool rsiFlipUp = ta.crossover(rsi, rsiMid)
bool rsiFlipDn = ta.crossunder(rsi, rsiMid)

// ─── Filters ─────────────────────────────────────────────────────────────────
bool inLondon = na(time(timeframe.period, sessLondon)) == false
bool inNY     = na(time(timeframe.period, sessNY))     == false
bool sessOk   = not useSession or inLondon or inNY

bool fridayLate = dayofweek == dayofweek.friday and hour >= 20
bool weekOk     = not noFri or not fridayLate

float atrPct = atr / close * 100.0
bool  volOk  = atrPct >= minAtrPct and atrPct <= maxAtrPct

// Daily loss cutoff — reset on date change.
var float dayStartEquity = strategy.equity
bool newDay = ta.change(dayofmonth) != 0
if newDay
    dayStartEquity := strategy.equity
float dailyLossPct = (dayStartEquity - strategy.equity) / dayStartEquity * 100.0
bool  ddOk         = dailyLossPct < maxDailyDD

// Cooldown after last exit
var int lastExitBar = -10000
if strategy.position_size == 0 and strategy.position_size[1] != 0
    lastExitBar := bar_index
bool cooldownOk = bar_index - lastExitBar >= cooldownBars

bool baseGate = sessOk and weekOk and volOk and ddOk and cooldownOk and strategy.position_size == 0

// ─── Signal composition ─────────────────────────────────────────────────────
bool longTrigger  = rsiFlipUp or (requireEngulf ? bullEngulf : (bullEngulf or close > ema20 and close[1] <= ema20[1]))
bool shortTrigger = rsiFlipDn or (requireEngulf ? bearEngulf : (bearEngulf or close < ema20 and close[1] >= ema20[1]))

bool longSignal  = allowLong  and bullBias and pulledBackLong  and longTrigger  and baseGate
bool shortSignal = allowShort and bearBias and pulledBackShort and shortTrigger and baseGate

// ─── Position sizing (risk-based) ───────────────────────────────────────────
// qty = riskUsd / stopDist   → each losing trade caps at exactly riskPct of equity.
// For XAUUSD on TradingView, 1 unit = 1 oz. Broker may require fractional lots.
float stopDist = atr * atrMult
float riskUsd  = strategy.equity * riskPct / 100.0
float qty      = stopDist > 0 ? riskUsd / stopDist : 0.0

// ─── Order management state ─────────────────────────────────────────────────
var float entryPrice   = na
var float initialStop  = na
var float finalTP      = na
var float partialTP    = na
var bool  partialDone  = false
var float trailStop    = na

// ─── Entries ────────────────────────────────────────────────────────────────
if longSignal and qty > 0 and barstate.isconfirmed
    entryPrice  := close
    initialStop := close - stopDist
    partialTP   := close + stopDist * partialR
    finalTP     := close + stopDist * rewardR
    trailStop   := initialStop
    partialDone := false
    strategy.entry("L", strategy.long, qty=qty)
    strategy.exit("L-Part", from_entry="L", qty_percent=partialPct, limit=partialTP, stop=initialStop, comment_loss="L-Stop")
    strategy.exit("L-Run",  from_entry="L", limit=finalTP,          stop=initialStop, comment_loss="L-Stop")

if shortSignal and qty > 0 and barstate.isconfirmed
    entryPrice  := close
    initialStop := close + stopDist
    partialTP   := close - stopDist * partialR
    finalTP     := close - stopDist * rewardR
    trailStop   := initialStop
    partialDone := false
    strategy.entry("S", strategy.short, qty=qty)
    strategy.exit("S-Part", from_entry="S", qty_percent=partialPct, limit=partialTP, stop=initialStop, comment_loss="S-Stop")
    strategy.exit("S-Run",  from_entry="S", limit=finalTP,          stop=initialStop, comment_loss="S-Stop")

// ─── In-trade management: BE after 1R, then ATR trail after TP1 ─────────────
if strategy.position_size > 0
    float rMove = (close - entryPrice) / (entryPrice - initialStop)
    // move to breakeven at +1R
    if rMove >= 1.0
        trailStop := math.max(trailStop, entryPrice)
    // mark partial done when high has traded through partialTP
    if not partialDone and high >= partialTP
        partialDone := true
    // ATR trail after partial fill
    if partialDone and useTrail
        trailStop := math.max(trailStop, close - atr * trailMult)
    // push updated stop on the runner leg only
    strategy.exit("L-Run", from_entry="L", limit=finalTP, stop=trailStop)

if strategy.position_size < 0
    float rMove = (entryPrice - close) / (initialStop - entryPrice)
    if rMove >= 1.0
        trailStop := math.min(trailStop, entryPrice)
    if not partialDone and low <= partialTP
        partialDone := true
    if partialDone and useTrail
        trailStop := math.min(trailStop, close + atr * trailMult)
    strategy.exit("S-Run", from_entry="S", limit=finalTP, stop=trailStop)

// Reset state cleanly after a flat close
if strategy.position_size == 0 and strategy.position_size[1] != 0
    entryPrice  := na
    initialStop := na
    partialTP   := na
    finalTP     := na
    trailStop   := na
    partialDone := false

// ─── Plots ──────────────────────────────────────────────────────────────────
plot(ema20, "EMA20", color = color.new(color.orange, 0), linewidth = 2)
plot(bullBias ?  1 : bearBias ? -1 : 0, "HTF bias (1=bull, -1=bear)",
     color = color.new(color.gray, 100), display = display.data_window)

plot(strategy.position_size > 0 ? initialStop : strategy.position_size < 0 ? initialStop : na,
     "Initial stop", color = color.new(color.red, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 ? trailStop : na,
     "Active stop", color = color.new(color.maroon, 0), style = plot.style_linebr, linewidth = 2)
plot(strategy.position_size != 0 ? finalTP : na,
     "Final TP",   color = color.new(color.green, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 and not partialDone ? partialTP : na,
     "Partial TP", color = color.new(color.teal, 0), style = plot.style_linebr)

bgcolor(bullBias ? color.new(color.green, 92) : bearBias ? color.new(color.red, 92) : na, title="HTF bias tint")
bgcolor(sessOk and weekOk ? na : color.new(color.gray, 90), title="Out-of-session tint")

// ─── Alerts ─────────────────────────────────────────────────────────────────
alertcondition(longSignal,  "XAU Long Signal",  "XAUUSD long setup — pullback in HTF uptrend")
alertcondition(shortSignal, "XAU Short Signal", "XAUUSD short setup — pullback in HTF downtrend")

// ─── Info table ─────────────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 8, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "HTF bias",     bgcolor=color.new(color.gray, 80))
    table.cell(info, 1, 0, bullBias ? "BULL" : bearBias ? "BEAR" : "flat",
               text_color = bullBias ? color.green : bearBias ? color.red : color.gray)
    table.cell(info, 0, 1, "ATR %",        bgcolor=color.new(color.gray, 80))
    table.cell(info, 1, 1, str.tostring(atrPct, "#.###") + " %")
    table.cell(info, 0, 2, "Session ok",   bgcolor=color.new(color.gray, 80))
    table.cell(info, 1, 2, sessOk and weekOk ? "yes" : "no")
    table.cell(info, 0, 3, "Daily loss",   bgcolor=color.new(color.gray, 80))
    table.cell(info, 1, 3, str.tostring(dailyLossPct, "#.##") + " %",
               text_color = dailyLossPct >= maxDailyDD ? color.red : color.gray)
    table.cell(info, 0, 4, "Equity",       bgcolor=color.new(color.gray, 80))
    table.cell(info, 1, 4, str.tostring(strategy.equity, "#.##"))
    table.cell(info, 0, 5, "Open pos",     bgcolor=color.new(color.gray, 80))
    table.cell(info, 1, 5, str.tostring(strategy.position_size, "#.####"))
    table.cell(info, 0, 6, "Risk / trade", bgcolor=color.new(color.gray, 80))
    table.cell(info, 1, 6, str.tostring(riskPct, "#.#") + " %")
    table.cell(info, 0, 7, "Cooldown ok",  bgcolor=color.new(color.gray, 80))
    table.cell(info, 1, 7, cooldownOk ? "yes" : "no")
