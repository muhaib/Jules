# ---- API ---------------------------------------------------------------
DATABASE_URL=postgres://aicg:aicg@localhost:5432/aicg
# openssl rand -hex 32
SESSION_SECRET=change-me-to-at-least-32-random-characters
PORT=4000
# Where the dashboard runs; used for CORS and for links in notification email.
DASHBOARD_URL=http://localhost:3000
# Set to false once your accounts exist, to stop new sign-ups.
ALLOW_REGISTRATION=true
# Run pending migrations at boot. Set false if you run them in a deploy step.
MIGRATE_ON_BOOT=true
# Number of proxies in front of the API, or a comma-separated CIDR list.
TRUST_PROXY=false
# Point this at your own signature file to override the bundled one.
# CRAWLERS_FILE=/etc/ai-crawler-guard/crawlers.json

# ---- Optional email notification for licensing inquiries ---------------
# Leave unset and inquiries are stored and shown in the dashboard only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="AI Crawler Guard <no-reply@example.com>"

# ---- Dashboard ---------------------------------------------------------
# Server-side base URL the dashboard uses to reach the API.
API_URL=http://localhost:4000

# ---- A site using the middleware ---------------------------------------
AICG_API_URL=http://localhost:4000
AICG_SITE_KEY=
AICG_SITE_ID=
# false | true | <hop count> | comma-separated CIDRs of your own proxies
AICG_TRUST_PROXY=false
# store | hash | none
AICG_LOG_IP=store
# Fetch operator-published IP range lists (outbound HTTPS from your server).
AICG_FETCH_RANGES=false
