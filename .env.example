# ---------------------------------------------------------------------------
# BranchCheck configuration
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/branchcheck?schema=public"

# 32+ character secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Session lifetime in hours (sliding; revocable server-side)
SESSION_TTL_HOURS=12

# Public base URL, used in notification links and PDF footers
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Evidence storage
#   STORAGE_DRIVER=local  -> files written under STORAGE_LOCAL_DIR
#   STORAGE_DRIVER=s3     -> any S3-compatible object storage (AWS S3, R2, MinIO)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./storage"

# S3 / S3-compatible settings (only needed when STORAGE_DRIVER=s3)
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Max evidence upload size in MB. Evidence is stored uncompressed — quality matters.
MAX_UPLOAD_MB=25
